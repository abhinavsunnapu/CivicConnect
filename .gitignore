# ==========================================================
# CivicConnect - .gitignore
# Covers: React/Vite (Node), Java/Spring Boot, Python/FastAPI,
#         environment files, IDEs and operating systems
# ==========================================================

# ----------------------------------------------------------
# Environment & secrets
# ----------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.jks
secrets/

# ----------------------------------------------------------
# Node / React / Vite (frontend)
# ----------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.local
.eslintcache
.npm/
.pnpm-store/
.yarn/*
!.yarn/releases
!.yarn/plugins
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------------------------------------
# Java / Spring Boot (backend)
# ----------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
# Maven
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar
# Spring Boot local overrides
application-local.properties
application-local.yml
# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ----------------------------------------------------------
# Python / FastAPI / YOLOv8 (ai-service)
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
.ipynb_checkpoints/
# YOLO / ML artifacts (large files - keep out of git)
runs/
*.pt
*.onnx
*.engine
datasets/

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
pgdata/

# ----------------------------------------------------------
# Uploads
# ----------------------------------------------------------
uploads/

# ----------------------------------------------------------
# Logs & temp files
# ----------------------------------------------------------
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.swp

# ----------------------------------------------------------
# IDEs & editors
# ----------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ----------------------------------------------------------
# Operating systems
# ----------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
